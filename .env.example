# Kopieren nach .env.local und ausfüllen. Niemals echte Werte einchecken.

# --- Anwendung ---
# Produktname (zentral änderbar; Standard: Freigabeklar)
NEXT_PUBLIC_APP_NAME=Freigabeklar
# Öffentliche Basis-URL ohne Slash am Ende (lokal: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Gültigkeit privater Freigabelinks in Tagen (1–365)
SHARE_LINK_VALID_DAYS=30

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUR serverseitig! Umgeht RLS. Niemals mit NEXT_PUBLIC_ versehen.
SUPABASE_SERVICE_ROLE_KEY=

# --- Geheimnisse, die du selbst erzeugst ---
# 32 Byte Zufall, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LINK_ENCRYPTION_KEY=
# Beliebiger langer Zufallswert (Salz für das Hashen von IPs im Rate Limit)
RATE_LIMIT_SALT=
# Beliebiger langer Zufallswert; der Scheduler ruft /api/cron/reminders mit "Authorization: Bearer <CRON_SECRET>" auf
CRON_SECRET=

# --- E-Mail (Resend) ---
RESEND_API_KEY=
# Verifizierte Absenderadresse, z. B. "Freigabeklar <freigabe@deine-domain.de>"
EMAIL_FROM=
# NUR lokale Entwicklung ohne Resend: "console" protokolliert Mails, sendet aber NICHTS.
# Wird in Produktion (NODE_ENV=production) ignoriert.
EMAIL_DRIVER=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Preis-IDs der beiden Tarife (wiederkehrend, monatlich, netto 29 EUR bzw. 49 EUR)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STUDIO=
